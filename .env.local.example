# Existing REST content source. Keep this separate from AI cloud providers.
NEXT_PUBLIC_API_URL=http://127.0.0.1:38655

# Client-safe Live2D selection.
NEXT_PUBLIC_VTUBER_MODEL_ID=ichigo-14

# Cloud LLM. Use "gemini" or "openai-compatible".
AI_CHAT_PROVIDER=gemini
AI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=

DEEPSEEK_API_KEY=

# Required only when AI_CHAT_PROVIDER=openai-compatible.
AI_CHAT_BASE_URL=https://api.openai.com/v1
AI_CHAT_API_KEY=

# OpenAI-compatible cloud speech recognition.
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh

# Without these optional variables, Live2D expressions use local presets.

# OpenAI-compatible expression provider
LIVE2D_EXPRESSION_BASE_URL=https://api.openai.com/v1
LIVE2D_EXPRESSION_API_KEY=
LIVE2D_EXPRESSION_MODEL=gpt-4o-mini

# OpenAI-compatible speech provider
TTS_PROVIDER=openai-compatible
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts

# Volcengine / Doubao TTS HTTP V1. Use this instead of the three TTS_* variables above.
# Get App ID, Access Token, Cluster and Voice Type from console.volcengine.com.
# Do not prefix these names with NEXT_PUBLIC_; they must remain server-only.
# TTS_PROVIDER=volcengine
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_VOICE_TYPE=
VOLC_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v1/tts
# Optional, each accepts 0.5 to 2.0.
VOLC_TTS_SPEED_RATIO=1
VOLC_TTS_VOLUME_RATIO=1
VOLC_TTS_PITCH_RATIO=1
